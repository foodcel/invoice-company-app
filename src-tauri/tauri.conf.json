{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soumissions et factures",
  "version": "0.1.3",
  "identifier": "ca.hermitage.invoice-company-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Soumissions et factures", "width": 1440, "height": 900, "minWidth": 600, "minHeight": 650 }],
    "security": { "capabilities": ["default"] }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGQUJBRTc5ODE1NEU5OTQKUldTVTZWU0JlYTZyVDBBU2l2eW5xYnM1RytXamx1THlPV3FTY2N3TjhEM3VobUN0MUgvN0hSejYK",
      "endpoints": ["https://github.com/foodcel/invoice-company-app/releases/latest/download/latest.json"]
    }
  }
}
